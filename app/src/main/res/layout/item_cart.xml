<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/itemCartImage"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="#E4EDE8"
            android:scaleType="centerInside"
            android:src="@drawable/logo_chilltea" />

        <ImageView
            android:id="@+id/itemCartBtnDelete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_delete"
            app:tint="#D32F2F"
            android:padding="2dp"/>

        <LinearLayout
            android:id="@+id/infoLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/itemCartImage"
            android:layout_toStartOf="@id/itemCartBtnDelete"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/itemCartName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trà Sữa Trân Châu"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/itemCartPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="35.000 đ"
                android:textColor="#B48D5B"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/itemCartBtnDelete"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/itemCartBtnMinus"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="-"
                android:textColor="#184343"
                app:strokeColor="#184343"
                app:strokeWidth="1dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp" />

            <TextView
                android:id="@+id/itemCartQuantity"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:text="2"
                android:gravity="center"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/itemCartBtnPlus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="+"
                android:textColor="#FFFFFF"
                app:backgroundTint="#184343"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                app:cornerRadius="4dp" />
        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>